  "components": {
    "schemas": {
      "EvolutionRequest": {
        "properties": {
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "seed": {
            "type": "integer",
            "exclusiveMaximum": 4294967296.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 20261013
          },
          "generations": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Generations",
            "default": 3
          },
          "train_samples": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 2.0,
            "title": "Train Samples",
            "default": 60
          },
          "validation_samples": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 2.0,
            "title": "Validation Samples",
            "default": 80
          },
          "test_samples": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 2.0,
            "title": "Test Samples",
            "default": 200
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw"
        ],
        "title": "EvolutionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabRequest": {
        "properties": {
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "capacities": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Capacities"
          },
          "availability": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Availability"
          },
          "supply_factor": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Supply Factor",
            "default": 1.0
          },
          "demand_factor": {
            "type": "number",
            "maximum": 2.0,
            "exclusiveMinimum": 0.0,
            "title": "Demand Factor",
            "default": 1.0
          },
          "source_losses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Source Losses"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw",
          "capacities",
          "availability"
        ],
        "title": "LabRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
