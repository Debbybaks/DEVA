  "components": {
    "schemas": {
      "DomainRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "seed": {
            "type": "integer",
            "exclusiveMaximum": 4294967296.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 20261220
          },
          "strategy": {
            "type": "string",
            "title": "Strategy",
            "default": "hybrid"
          },
          "target_failure_probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Target Failure Probability",
            "default": 0.02
          },
          "maximum_cost": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Maximum Cost",
            "default": 300
          },
          "maximum_simulations": {
            "type": "integer",
            "maximum": 1500.0,
            "minimum": 1.0,
            "title": "Maximum Simulations",
            "default": 400
          },
          "maximum_candidates": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Maximum Candidates",
            "default": 16
          },
          "maximum_generations": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Maximum Generations",
            "default": 4
          },
          "maximum_seconds": {
            "type": "number",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Maximum Seconds",
            "default": 120
          },
          "training_samples": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 2.0,
            "title": "Training Samples",
            "default": 8
          },
          "validation_samples": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 2.0,
            "title": "Validation Samples",
            "default": 12
          },
          "heldout_samples": {
            "type": "integer",
            "maximum": 256.0,
            "minimum": 2.0,
            "title": "Heldout Samples",
            "default": 40
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "domain",
          "raw"
        ],
        "title": "DomainRequest"
      },
      "EvolutionRequest": {
        "properties": {
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "seed": {
            "type": "integer",
            "exclusiveMaximum": 4294967296.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 20261013
          },
          "generations": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Generations",
            "default": 3
          },
          "train_samples": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 2.0,
            "title": "Train Samples",
            "default": 60
          },
          "validation_samples": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 2.0,
            "title": "Validation Samples",
            "default": 80
          },
          "test_samples": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 2.0,
            "title": "Test Samples",
            "default": 200
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw"
        ],
        "title": "EvolutionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HydraulicLabRequest": {
        "properties": {
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "diameters_m": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Diameters M"
          },
          "closed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 60,
            "title": "Closed"
          },
          "demand_factor": {
            "type": "number",
            "maximum": 3.0,
            "exclusiveMinimum": 0.0,
            "title": "Demand Factor",
            "default": 1.0
          },
          "source_head_delta_m": {
            "type": "number",
            "maximum": 100.0,
            "minimum": -100.0,
            "title": "Source Head Delta M",
            "default": 0.0
          },
          "friction_factor": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Friction Factor",
            "default": 1.0
          },
          "source_losses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Source Losses"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw",
          "diameters_m"
        ],
        "title": "HydraulicLabRequest"
      },
